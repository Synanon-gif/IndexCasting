# =============================================================================
# PROFILE: production-readonly (example only — copy to .env.e2e.production-readonly, gitignored)
# =============================================================================
# Use for: public / read-only Playwright smokes against the live or production-like web app.
#
# Run (preset in package.json):
#   npm run e2e:prod:public
# Or manually:
#   E2E_ENV_FILE=.env.e2e.production-readonly PLAYWRIGHT_SKIP_WEB_SERVER=1 npx playwright test …
#
# DO NOT add any of the following to this profile (fail-closed guard and policy):
# - SUPABASE_SERVICE_ROLE_KEY
# - E2E_ALLOW_SEED_ON_THIS_DATABASE
# - E2E_ALLOW_CHAT_WRITES
# - E2E_ALLOW_OPTION_LIFECYCLE_MUTATIONS
# - E2E_ALLOW_HOSTED_WRITES
#
# Optional discovery-only Supabase anon/project URL in your *app* build is unrelated to this file;
# this template intentionally omits server credentials used for seeding or service-role access.
#
# =============================================================================

# Production-like public web (adjust host if needed)
E2E_BASE_URL=https://www.index-casting.com
PLAYWRIGHT_SKIP_WEB_SERVER=1

# Optional: only if you intentionally run password-based checks against this host (usually empty for pure public smoke)
# PLAYWRIGHT_TEST_PASSWORD=

# Guest-link positive paths (optional)
# E2E_GUEST_LINK_TOKEN=

# If E2E_BASE_URL is a staging hostname under *.index-casting.com, list the exact hostname here
# (comma-separated) so it is not classified as production-like. Not needed for www / typical public prod smoke.
# E2E_SAFETY_ALLOWLIST_INDEX_CASTING_HOSTS=
