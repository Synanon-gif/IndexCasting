# =============================================================================
# PROFILE: staging / branch / preview — full E2E + seed (example — copy to .env.e2e.staging, gitignored)
# =============================================================================
#
# Enable seed latch, SUPABASE_SERVICE_ROLE_KEY, and write gates ONLY when ALL are true:
# 1) E2E_BASE_URL is disposable (Vercel preview, branch deploy, or allowlisted staging host) — NOT prod customers.
# 2) EXPO_PUBLIC_SUPABASE_URL is a NON-production Supabase project or branch (never prod ref + seed).
# 3) You accept mutating test data; re-seed or reset DB as needed.
#
# On *.index-casting.com hosts, use E2E_SAFETY_ALLOWLIST_INDEX_CASTING_HOSTS with the exact staging hostname,
# or prefer a non-prod URL shape to reduce misconfiguration risk.
#
# =============================================================================

E2E_BASE_URL=https://your-preview-or-staging.example
PLAYWRIGHT_SKIP_WEB_SERVER=1

# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_NON_PROD_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Uncomment ONLY on disposable DB + non-prod Supabase ---
# SUPABASE_SERVICE_ROLE_KEY=
# E2E_SEED_USER_PASSWORD=
PLAYWRIGHT_TEST_PASSWORD=

# E2E_ALLOW_SEED_ON_THIS_DATABASE=I_UNDERSTAND

# --- Playwright write gates (hosted URLs also need hosted-write ack) ---
# E2E_ALLOW_CHAT_WRITES=I_UNDERSTAND
# E2E_ALLOW_OPTION_LIFECYCLE_MUTATIONS=I_UNDERSTAND
# E2E_ALLOW_HOSTED_WRITES=I_UNDERSTAND_HOSTED_WRITE_RISK

# E2E_SAFETY_ALLOWLIST_INDEX_CASTING_HOSTS=staging.your-branch.index-casting.com

# Supabase Dashboard → Edge secrets (for Full E2E without real Checkout / invoice e-mail / Stripe cancel):
# E2E_BILLING_NO_EXTERNAL_SIDE_EFFECTS=I_UNDERSTAND
# Optional: E2E_STRIPE_LIVE_EXTERNAL_BLOCK=I_UNDERSTAND  (blocks Stripe API when key is sk_live_…)
# docs/e2e-billing-edge-guard.md

# Optional overrides (see .env.e2e.example)
# E2E_PUBLIC_AGENCY_SLUG=
# E2E_PUBLIC_CLIENT_SLUG=
# E2E_GUEST_LINK_TOKEN=
