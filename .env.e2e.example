# =============================================================================
# E2E / Playwright — copy to .env.e2e (gitignored). Never commit secrets.
# =============================================================================
#
# Named profiles (examples in repo — copy to a gitignored file, then point Playwright/seed at it):
#   E2E_ENV_FILE=.env.e2e.production-readonly   ←  .env.e2e.production-readonly.example  (no seed / no service role / no write latches)
#   E2E_ENV_FILE=.env.e2e.staging               ←  .env.e2e.staging.example (full E2E; only non-prod + disposable DB)
#   E2E_ENV_FILE=.env.e2e.local                 ←  .env.e2e.local.example (localhost Expo)
# Set E2E_ENV_FILE in shell or npm script only (not inside the file dotenv loads first).
#
# FAIL-CLOSED SAFETY (scripts/e2e/e2eSafetyGuard.cjs):
# - If E2E_BASE_URL points at index-casting.com (incl. www/web/subdomains), you MUST NOT set
#   E2E_ALLOW_SEED_ON_THIS_DATABASE, write-gate latches, or SUPABASE_SERVICE_ROLE_KEY together.
#   Use production-readonly env for public/read-only smokes, or a staging/branch URL for full E2E.
# - Optional: E2E_SAFETY_ALLOWLIST_INDEX_CASTING_HOSTS=staging.myhost.index-casting.com
#   (comma-separated full hostnames) to exempt staging subdomains from the production-like block.
#
# WARNING — hosted writes:
# Never set E2E_ALLOW_HOSTED_WRITES unless every account and DB row touched by
# Playwright is disposable E2E/staging test data. Production customer data must
# not be mutated by tests.
#
# Write-path inventory & recovery (harness audit, default-off gates):
# docs/e2e-write-path-inventory.md
# docs/e2e-write-recovery-plan.md
#

# -----------------------------------------------------------------------------
# Required for most login-based Playwright tests
# -----------------------------------------------------------------------------
# App under test (staging, local Expo web, or Vercel preview)
E2E_BASE_URL=http://localhost:8081
# Back-compat (Playwright docs)
# PLAYWRIGHT_BASE_URL=http://localhost:8081

# Shared password for seeded @index-casting.test users (after npm run seed:e2e)
PLAYWRIGHT_TEST_PASSWORD=
# Or mirror the seed password:
# E2E_SEED_USER_PASSWORD=

# Skip starting local web server when E2E_BASE_URL is already running (hosted / CI)
# PLAYWRIGHT_SKIP_WEB_SERVER=1

# Ignore preflight / runtime B2B gate skips (debug only — repeats slow doomed logins)
# E2E_IGNORE_PREFLIGHT_BLOCK=1

# -----------------------------------------------------------------------------
# Required only for scripts/e2e/seed-e2e-world.mjs (never in browser bundles)
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# E2E_SEED_USER_PASSWORD=
# E2E_ALLOW_SEED_ON_THIS_DATABASE=I_UNDERSTAND

# -----------------------------------------------------------------------------
# Required for stateful Playwright tests (explicit opt-in)
# -----------------------------------------------------------------------------
# Chat: B2B roundtrip, Agency↔Model Send (p0-messaging.spec.ts)
# E2E_ALLOW_CHAT_WRITES=I_UNDERSTAND

# Option lifecycle: Confirm availability, counter, Confirm job, etc. (p0-option-lifecycle-mutations.spec.ts)
# E2E_ALLOW_OPTION_LIFECYCLE_MUTATIONS=I_UNDERSTAND

# ADDITIONAL requirement when E2E_BASE_URL is hosted (not localhost/loopback or typical LAN IP):
# e.g. https://www.index-casting.com , Vercel previews, staging on public DNS.
# E2E_ALLOW_HOSTED_WRITES=I_UNDERSTAND_HOSTED_WRITE_RISK

# -----------------------------------------------------------------------------
# Optional overrides for Playwright
# -----------------------------------------------------------------------------
# E2E_AGENCY_OWNER_EMAIL=
# E2E_CLIENT_OWNER_EMAIL=
# E2E_MODEL_LINKED_EMAIL=

# Public profile slugs after seed (see scripts/e2e/seed-e2e-world.mjs)
# E2E_PUBLIC_AGENCY_SLUG=playwright-e2e-northwind
# E2E_PUBLIC_CLIENT_SLUG=playwright-e2e-horizon

# Guest link token (positive path tests — P1)
# E2E_GUEST_LINK_TOKEN=

# -----------------------------------------------------------------------------
# Billing / Stripe / Resend — Supabase Edge Function secrets (Dashboard), NOT Playwright
# -----------------------------------------------------------------------------
# Set on the Supabase project that serves Edge Functions (staging/branch), not in client .env:
#   E2E_BILLING_NO_EXTERNAL_SIDE_EFFECTS=I_UNDERSTAND
#     Blocks: create-checkout-session, send-invoice-via-stripe, send-invoice-via-email (Resend),
#     stripe-cancel-dissolved-org. Default prod/staging without this = unchanged behavior.
# Optional belt-and-suspenders for Stripe-only paths when STRIPE_SECRET_KEY is sk_live_…:
#   E2E_STRIPE_LIVE_EXTERNAL_BLOCK=I_UNDERSTAND
# See docs/e2e-billing-edge-guard.md
