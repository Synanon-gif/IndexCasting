# =============================================================================
# PROFILE: local / dev (Expo web — example — copy to .env.e2e.local or default .env.e2e)
# =============================================================================
#
# Typical flow: Expo on localhost; Playwright may start the web server unless you set SKIP flags.
#
#   E2E_ENV_FILE=.env.e2e.local npx playwright test
# Or use the default file name:
#   cp .env.e2e.local.example .env.e2e
#
# =============================================================================

E2E_BASE_URL=http://localhost:8081
# Leave unset so Playwright can start Expo web, unless a server is already running:
# PLAYWRIGHT_SKIP_WEB_SERVER=1

# Local or branch Supabase (placeholders)
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Seed (local disposable DB only)
# SUPABASE_SERVICE_ROLE_KEY=
# E2E_SEED_USER_PASSWORD=
# E2E_ALLOW_SEED_ON_THIS_DATABASE=I_UNDERSTAND

# Writes on localhost/LAN do not need E2E_ALLOW_HOSTED_WRITES
# E2E_ALLOW_CHAT_WRITES=I_UNDERSTAND
# E2E_ALLOW_OPTION_LIFECYCLE_MUTATIONS=I_UNDERSTAND
